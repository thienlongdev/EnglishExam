# Backend only. Set values in the provider's secret manager. Never commit secrets.
SERVER_ADDRESS=0.0.0.0
PORT=8081
COOKIE_SECURE=true
APP_ORIGIN=https://YOUR-VERIFIED-FRONTEND-HOST
DB_URL=jdbc:sqlserver://YOUR-SQL-HOST:1433;databaseName=YOUR-ISOLATED-APP-DATABASE;encrypt=true;trustServerCertificate=false
DB_USERNAME=YOUR-LEAST-PRIVILEGE-APP-USER
DB_PASSWORD=
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=

# Frontend/Vercel only. Keep preview until the public full-stack gate passes.
BACKEND_URL=https://YOUR-VERIFIED-BACKEND-HOST
APP_SERVICE_MODE=preview
